# Ausschließlich für Docker Compose; keine echten Zugangsdaten eintragen.
POSTGRES_PASSWORD=BITTE_LOKAL_ZUFAELLIG_ERZEUGEN
# Optional: AI integration via compose.ai.yaml. Never put the key in this file.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_API_KEY_FILE=/absolute/path/outside/repo/azure-key
